# Salidas generadas por los playbooks (se recrean al ejecutarlos)
informes/
entorno-prueba/

# Ansible
*.retry
.vault_pass

# Clave SSH y known_hosts del laboratorio multi-host (los genera flota.sh)
.ssh_lab/

# Python bytecode (los plugins generan __pycache__ al ejecutarse)
__pycache__/
*.pyc

# Artefactos del build/install de la colección propia (playbook 32) — se
# recrean al ejecutarlo; la FUENTE vive en coleccion_lab/ y sí se versiona.
/tmp-coleccion/
